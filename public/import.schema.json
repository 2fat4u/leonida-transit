{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Leonida Transit Network v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "status",
    "source",
    "stops",
    "lines"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "$ref": "#/$defs/text"
    },
    "status": {
      "enum": [
        "demo",
        "community",
        "research"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "url",
        "license",
        "checkedAt"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 1000
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "checkedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "stops": {
      "type": "array",
      "minItems": 2,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "x": {
            "type": "number",
            "minimum": 30,
            "maximum": 970
          },
          "y": {
            "type": "number",
            "minimum": 30,
            "maximum": 770
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          },
          "position": {
            "type": "object",
            "required": [
              "x",
              "y",
              "system",
              "sourceId"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -200000,
                "maximum": 200000
              },
              "y": {
                "type": "number",
                "minimum": -200000,
                "maximum": 200000
              },
              "system": {
                "const": "game"
              },
              "sourceId": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mode",
          "color",
          "patterns"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "mode": {
            "enum": [
              "bus",
              "metro",
              "rail"
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "id",
                "headsign",
                "stops"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "headsign": {
                  "$ref": "#/$defs/text"
                },
                "stops": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 300,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "minutes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 299,
                  "items": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0.1,
                    "maximum": 180
                  }
                },
                "partial": {
                  "type": "boolean"
                },
                "evidence": {
                  "$ref": "#/$defs/evidence"
                },
                "airDistancesMetres": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 299,
                  "items": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 600000
                  },
                  "description": "Straight-line metres to the next stop call, one value per segment. Recomputed from sourced game positions on import; null when positions are missing. Not road, track or walking distance."
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "checkedAt",
          "scope"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 1000
          },
          "checkedAt": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "evidence": {
      "type": "object",
      "required": [
        "sources",
        "level"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "level": {
          "enum": [
            "single-source",
            "cross-listed",
            "observed"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    }
  },
  "$comment": "The importer also enforces unique IDs, existing stop references, different consecutive stops, one minute value per segment when minutes are supplied (otherwise unknown), valid dates and at most 3000 occurrences. Text cannot be whitespace only. Original names are preserved. Coordinates are schematic, not GPS. Loops must repeat their first stop at the end; reverse directions need separate patterns."
}
